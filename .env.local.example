# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Python Backend URL (for exam paper parsing)
PYTHON_BACKEND_URL=http://localhost:5000

# Google OAuth (optional)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ── Asset Storage (Cloudflare R2 or any CDN) ──────────────────────────────
# Leave blank to serve assets locally from /public/ (development default).
# In production, set this to your R2 public bucket URL:
#   NEXT_PUBLIC_ASSET_BASE_URL=https://pub-XXXX.r2.dev
# All PDF and image URLs will be automatically prefixed with this value.
# Set to your GitHub assets repo base URL after running scripts/upload_images_to_github.py:
#   NEXT_PUBLIC_ASSET_BASE_URL=https://raw.githubusercontent.com/YOUR_USERNAME/igcse-assets/main
NEXT_PUBLIC_ASSET_BASE_URL=

# Cloudflare R2 credentials (only needed when running scripts/upload_to_r2.py)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=igcse-assets